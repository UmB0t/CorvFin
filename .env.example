# ==============================================================================
# OmniFin Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base Path
# Desenvolvimento local (raiz):
BASE_PATH=
# Produção atrás do Nginx:
# BASE_PATH=/omnifin

# Storage Driver ('mongodb' ou 'json')
STORAGE_DRIVER=mongodb

# MongoDB Connection (Internal Docker network: mongodb-financas:27017)
# Format: mongodb://<user>:<password>@<host>:<port>/<database>?authSource=<auth_db>
MONGODB_URI=mongodb://financas_pro_app:CHANGE_ME@mongodb-financas:27017/financas_pro?authSource=financas_pro
MONGODB_DB_NAME=financas_pro

# JWT Authentication Secret Key (Obrigatório em produção com no mínimo 32 caracteres gerados de forma segura)
# Exemplo de geração segura: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_RANDOM_KEY_MIN_32_CHARS

# ==============================================================================
# HTTP Frontier & Network Security (Checkpoint Security 1)
# ==============================================================================
# Trust Proxy: Número de saltos de proxy reverso confiáveis (1 para Nginx frontal padrão)
# Confirme no Nginx os cabeçalhos: X-Real-IP, X-Forwarded-For, X-Forwarded-Proto
TRUST_PROXY=1

# CORS Allowed Origins (separadas por vírgula em produção)
# Requisições sem Origin (same-origin, PWA interna, apps móveis) são permitidas por padrão.
CORS_ALLOWED_ORIGINS=https://lorenzo.360ava.com

# Body / Payload Limit (tamanho máximo do payload JSON - padrão conservador: 5mb)
BODY_LIMIT=5mb

# Rate Limiting de Autenticação (Janela em ms e máximo de tentativas de login/registro)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15

# Rate Limiting de Consultas IA (Janela em ms e máximo de consultas por usuário autenticado)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30

# Rate Limiting Geral da API (/api/*)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# ==============================================================================
# n8n AI Agent Integration (Conversational Read-Only - Basic Auth)
# ==============================================================================
# URL do Webhook do n8n (ex: http://localhost:5678/webhook/omnifin-ai ou http://n8n:5678/webhook/omnifin-ai)
N8N_AI_WEBHOOK_URL=
# Usuário e senha para autenticação HTTP Basic Auth configurada no Webhook do n8n
N8N_AI_BASIC_AUTH_USER=
N8N_AI_BASIC_AUTH_PASSWORD=
# Timeout em milissegundos para requisições ao n8n (padrão: 30000 / 30 segundos)
AI_REQUEST_TIMEOUT_MS=30000

# ==============================================================================
# n8n AI Actions Integration (Controlled Transactional Actions - Basic Auth)
# ==============================================================================
# Webhook de produção para interpretação de ações estruturadas (/webhook/<id>)
N8N_AI_ACTION_WEBHOOK_URL=
N8N_AI_ACTION_BASIC_AUTH_USER=
N8N_AI_ACTION_BASIC_AUTH_PASSWORD=
AI_ACTION_REQUEST_TIMEOUT_MS=30000
# TTL em milissegundos para ações pendentes multi-turno (padrão: 1800000 / 30 minutos)
AI_PENDING_ACTION_TTL_MS=1800000
