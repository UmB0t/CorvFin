# ==============================================================================
# OmniFin Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base Path
# Desenvolvimento local (raiz):
BASE_PATH=
# Produção atrás do Nginx:
# BASE_PATH=/omnifin

# Storage Driver ('mongodb' ou 'json')
STORAGE_DRIVER=mongodb

# MongoDB Connection (Internal Docker network: mongodb-financas:27017)
# Format: mongodb://<user>:<password>@<host>:<port>/<database>?authSource=<auth_db>
MONGODB_URI=mongodb://financas_pro_app:CHANGE_ME@mongodb-financas:27017/financas_pro?authSource=financas_pro
MONGODB_DB_NAME=financas_pro

# JWT Authentication Secret Key
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_RANDOM_KEY

# ==============================================================================
# n8n AI Agent Integration (Conversational Read-Only - Basic Auth)
# ==============================================================================
# URL do Webhook do n8n (ex: http://localhost:5678/webhook/omnifin-ai ou http://n8n:5678/webhook/omnifin-ai)
N8N_AI_WEBHOOK_URL=
# Usuário e senha para autenticação HTTP Basic Auth configurada no Webhook do n8n
N8N_AI_BASIC_AUTH_USER=
N8N_AI_BASIC_AUTH_PASSWORD=
# Timeout em milissegundos para requisições ao n8n (padrão: 30000 / 30 segundos)
AI_REQUEST_TIMEOUT_MS=30000

# ==============================================================================
# n8n AI Actions Integration (Controlled Transactional Actions - Basic Auth)
# ==============================================================================
# Webhook de produção para interpretação de ações estruturadas (/webhook/<id>)
N8N_AI_ACTION_WEBHOOK_URL=
N8N_AI_ACTION_BASIC_AUTH_USER=
N8N_AI_ACTION_BASIC_AUTH_PASSWORD=
AI_ACTION_REQUEST_TIMEOUT_MS=30000
# TTL em milissegundos para ações pendentes multi-turno (padrão: 1800000 / 30 minutos)
AI_PENDING_ACTION_TTL_MS=1800000
